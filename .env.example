# Google AI Studio 免費申請：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 選填：綁定帳單的另一個專案的 key（Standard 方案）。免費版放棄時，分析清單會出現「付費分析」按鈕
GEMINI_PAID_API_KEY=

# 分析引擎，預設 gemini
ENGINE=gemini

# 要寫進 Notion 才需要；留空則輸出桌面 .md
# NOTION_DATABASE_ID：要寫入的資料庫 ID（每場會議＝資料庫的一列，需有 Name 標題欄與 Date 日期欄）
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 伺服器埠號
PORT=3737
